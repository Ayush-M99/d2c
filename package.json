{
  "name": "chatspaces",
  "private": true,
  "version": "0.0.1",
  "description": "Proximity-based anonymous real-time communication platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:start": "pwsh -File scripts/dev.ps1",
    "lint": "eslint \"packages/**/src/**/*.ts\"",
    "format": "prettier --write \"packages/**/src/**/*.ts\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
