# Node
NODE_ENV=development
PORT=3000

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_URL=postgresql://chatspaces:chatspaces_dev@localhost:5432/chatspaces

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chatspaces-gateway

# Session
SESSION_SECRET=change_me_in_production_32_chars_min

# GitHub MCP (required for github MCP server)
# GITHUB_TOKEN=your_token_here

# Logging
LOG_LEVEL=debug

# Security
# Salts device-fingerprint hashes. CHANGE THIS IN PRODUCTION.
FINGERPRINT_SALT=chatspaces_dev_salt
# Allowed origin for CORS and Socket.IO. Tighten in production.
CORS_ORIGIN=*
