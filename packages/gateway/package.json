{
  "name": "@chatspaces/gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --out-dir dist",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chatspaces/shared": "workspace:*",
    "@chatspaces/service-session": "workspace:*",
    "@chatspaces/service-geospace": "workspace:*",
    "@chatspaces/service-thread": "workspace:*",
    "@chatspaces/service-message": "workspace:*",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "tsup": "^8.0.2",
    "tsx": "^4.8.2",
    "vitest": "^1.5.0"
  }
}
