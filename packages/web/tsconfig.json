{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@chatspaces/shared": ["../shared/dist/browser.d.ts"]
    }
  },
  "include": ["src"]
}
